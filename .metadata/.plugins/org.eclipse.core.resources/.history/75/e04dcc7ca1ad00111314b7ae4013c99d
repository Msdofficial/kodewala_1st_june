package com.kodewala.stream.api2;

import java.util.Arrays;
import java.util.List;


public class Driver2 {
	
	public static void main(String[] args) 
	{
		List<String> city = Arrays.asList("BLR" , "CHE" , "HYD", "BLR" , "AHM" , "CHE" , "CH");
		
		// filter the city starting with 'C' and give me only one i.e., first city
		city.stream().filter(cities -> cities.startsWith("C")).limit(1)
				.forEach(e -> System.out.println(e));
		
		city.stream().sorted()       // Natural sorting
		.forEach(e -> System.out.println(e));
		
		// skip
		
		city.stream().skip(2)
		.forEach(e -> System.out.println(e));
	}

}
