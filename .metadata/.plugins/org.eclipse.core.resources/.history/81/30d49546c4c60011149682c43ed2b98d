package e.com.order.mngmnt;

public class DiscountCalculator {

	public int discountCalculator(int price, String type, int discount) {
		
		int finalAmount = 0;
		switch (type) {
		case "GOLD":
			finalAmount = price - (price * discount)/100;
			break;

		case "PLATINUM":
			finalAmount = price - (price * discount)/100 - 100 ;
			break;

		default:
			finalAmount = price;
			break;
		}
		return finalAmount;
	}

}
