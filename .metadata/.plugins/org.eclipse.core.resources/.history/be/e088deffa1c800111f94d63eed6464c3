package finance.oneloan;


import java.sql.Statement;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.ResultSet;
import java.sql.SQLException;


public class OrderHistory {
	
	public void getOrderHistory() throws ClassNotFoundException, SQLException
	{
		// STEP- 1. Register the driver (optional) --> dynamic class loading
		
		Class.forName("com.mysql.jdbc.Driver");
		
		// STEP- 2. Create the connection
		
		Connection connection = DriverManager.getConnection("jdbc:mysql://localhost:3306/1st_june_2026", "masood" , "#Msd@0000" );
		
		// STEP- 3. Create statement
		
		Statement statement = connection.createStatement();
		
		// STEP- 4. Execute Query
		
		String query = "select * from order_history";
		
		ResultSet rs = statement.executeQuery(query); // query will be executed.
		
		while(rs.next())
		{
			int id = rs.getInt(1);
			String item = rs.getString(2);
			int price = rs.getInt(3);
			String status = rs.getString(4);
			
			System.out.println("Id : "+id);
			System.out.println("item : "+item);
			System.out.println("price : "+price);
			System.out.println("status : "+status);
		}
	}

}
