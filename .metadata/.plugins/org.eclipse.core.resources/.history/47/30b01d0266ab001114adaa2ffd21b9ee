package com.kodewala.zepto.exceptionhandling;

public class Practice {
	
	public static void main(String[] args)
	{
		Practice p1 = new Practice();
		
		p1.calPercentage(100, 10);
	}

	
	public int calPercentage(int principle , int percent)
	{
		try
		{
			return (principle * percent) / 100 ;
		}
		finally
		{
			return 2*(principle * percent) / 100 ;
		}
	}
}
